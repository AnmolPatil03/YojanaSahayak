# Copy to .env and fill in the keys you have. Every provider is optional;
# providers without a key are skipped and Ollama is used as the offline fallback.

GROQ_API_KEY=
GITHUB_TOKEN=
OPENROUTER_API_KEY=
GEMINI_API_KEY=

OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=

# Optional overrides
YOJANA_LOG_LEVEL=INFO
YOJANA_LLM_CACHE_TTL_HOURS=168
YOJANA_ALLOW_UNREVIEWED_RULES=false
YOJANA_WARMUP_MODELS=true
YOJANA_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
HF_HOME=
